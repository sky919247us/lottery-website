SECRET_KEY="your-secret-key-here"
DATABASE_URL="sqlite:///./scratchcard.db"

# LINE Login 設定
LINE_CHANNEL_ID="你的_LINE_Channel_ID"
LINE_CHANNEL_SECRET="你的_LINE_Channel_Secret"
# 注意：此網址必須與 LINE Developers Console 中的 Callback URL 一致
LINE_REDIRECT_URI="http://localhost:5173/auth/callback"

# JWT 設定
JWT_SECRET_KEY="建議產生一個隨機字串"

# AI 玩法解析（Phase 2）
# 預設使用 Gemini（aistudio.google.com 申請免費 API Key）
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ---------- SHOPLINE Payments (SLP) ----------
# Merchant ID: 從 SLP 後台「設定」頁取得
SLP_MERCHANT_ID=""
# API Key: 後台「開發者管理 → 金鑰管理」 sk_xxx 完整值（後端伺服器用）
SLP_API_KEY=""
# Sign Key: 後台「開發者管理 → Webhook 管理 → 新增 Webhook」時系統產生
SLP_SIGN_KEY=""
# 環境 base URL（production 預設，sandbox 由 SLP 客服提供時再切換）
SLP_BASE_URL="https://api.shoplinepayments.com"
# 簽章演算法：sandbox / production 實測後固定
# 候選: hmac_sha256_sorted_body | hmac_sha256_concat_kv
SLP_SIGN_ALGO="hmac_sha256_sorted_body"
